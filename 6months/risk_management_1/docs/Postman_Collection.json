          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": 1,\n  \"regulation_update\": 1,\n  \"completed\": true,\n  \"notes\": \"Updated notes.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/checklist/1/",
          "host": ["{{base_url}}"],
          "path": ["api", "checklist", "1", ""]
