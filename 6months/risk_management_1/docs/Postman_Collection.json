          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": 1,\n  \"regulation_update\": 1,\n  \"completed\": false,\n  \"notes\": \"Initial assignment.\"\n}"
